# PlatformIO 构建产物 / 缓存（可达数百 MB，绝不入库）
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Arduino / 编译临时文件
build/
*.bin
*.elf
*.map
*.hex
*.d

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# 编辑器 / 系统
.idea/
.DS_Store
Thumbs.db
*~

# 本地配置（含个人串口号等，请各自修改 platformio.ini）
